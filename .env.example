# =============================================================================
# TOOLZEN — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in values for your environment.
# `.env.local` is gitignored and must never be committed.
#
# IMPORTANT SECURITY NOTE
# -----------------------------------------------------------------------------
# Any variable prefixed with VITE_ is embedded into the browser bundle and is
# therefore PUBLIC. Never put API keys, service-role keys, or secrets in a
# VITE_-prefixed variable. Server-side secrets belong in non-prefixed variables
# and are only read by server functions (introduced in Phase 4).
# =============================================================================

# Public canonical origin used for canonical URLs, Open Graph tags and sitemap
# generation. Defaults to https://www.etoolzen.com — override only if the site
# is served from a different origin.
VITE_SITE_URL=https://www.etoolzen.com

# -----------------------------------------------------------------------------
# Advertisements (Phase 1: preparation only)
# -----------------------------------------------------------------------------
# Ad slots render nothing unless this is explicitly set to "true".
# Leave as "false" during development. Actual ad-network integration is Phase 5
# and requires provider approval before any ad code is enabled.
VITE_ADS_ENABLED=false

# Google AdSense publisher ID (e.g. ca-pub-0000000000000000).
# Only used when VITE_ADS_ENABLED=true AND the account is approved.
# Leave empty until approval is granted — do not invent a value.
VITE_ADSENSE_CLIENT=

# -----------------------------------------------------------------------------
# Server-side only (Phase 4+). These are NOT exposed to the browser.
# -----------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# AI tools — the only server-side feature that is built
# -----------------------------------------------------------------------------
# The seven AI tools call /api/ai, a serverless function that holds the provider
# key. Without the key the function answers 503 and the tools show "not
# switched on yet" rather than inventing a result.
#
# Set these in the hosting dashboard (Vercel → Settings → Environment
# Variables), never in a committed file.
#
# AI_PROVIDER_API_KEY is the provider's secret key. Required to enable AI tools.
AI_PROVIDER_API_KEY=

# Optional. Defaults to https://api.openai.com/v1, so any OpenAI-compatible
# endpoint works — including a self-hosted one.
AI_PROVIDER_BASE_URL=

# Optional. Defaults to gpt-4o-mini.
AI_PROVIDER_MODEL=

# Optional. If set, /api/ai refuses requests whose Origin header does not match.
# Recommended in production: https://www.etoolzen.com
AI_ALLOWED_ORIGIN=

# -----------------------------------------------------------------------------
# AI tools — the build-time switch
# -----------------------------------------------------------------------------
# The AI tools are implemented, but they are only marked "live" in the registry
# when this is "true". Leave it false until AI_PROVIDER_API_KEY is set in the
# hosting environment; otherwise the homepage would advertise tools that cannot
# run.
VITE_AI_ENABLED=false
